#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_install:
	$(MAKE) install prefix=$(CURDIR)/debian/try/usr

override_dh_auto_test:
	# try's test suite needs kernel privileges (unshare namespaces,
	# overlayfs) that package build chroots don't grant -- same reasoning
	# as the TRY_REQUIRE_PROG configure-time patch. Tests already run
	# separately in CI (test-dist/test-checkout) with real privileges.
